<!-- views/register.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Create Account</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
  <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
    <h3 class="text-3xl mb-5">Create Account</h3>
    <form action="/register" method="post" class="flex flex-col gap-4">
      <input class="px-3 py-2 rounded-md bg-transparent border-2 border-zinc-800" type="text" name="name" placeholder="Name" required />
      <input class="px-3 py-2 rounded-md bg-transparent border-2 border-zinc-800" type="email" name="email" placeholder="Email" required />
      <input class="px-3 py-2 rounded-md bg-transparent border-2 border-zinc-800" type="text" name="username" placeholder="Username" required />
      <input class="px-3 py-2 rounded-md bg-transparent border-2 border-zinc-800" type="number" name="age" placeholder="Age" required />
      <input class="px-3 py-2 rounded-md bg-transparent border-2 border-zinc-800" type="password" name="password" placeholder="Password" required />
      <input class="px-3 py-2 rounded-md bg-blue-500 cursor-pointer" type="submit" value="Create Account" />
    </form>
  </div>
</body>
</html>
