<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Post Page</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-white min-h-screen flex flex-col items-center py-10 px-4">
  
  <div class="absolute top-4 right-4">
    <form action="/logout" method="POST">
      <button class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded">Logout</button>
    </form>
  </div>

  
  <div class="w-full max-w-xl text-left mb-6">
    <h1 class="text-2xl font-semibold">
      Hello, <%= user.name %> 👋
    </h1>
    <p class="text-sm text-gray-300">you can create a new post.</p>
  </div>

  
  <div class="w-full max-w-xl mb-6">
    <form action="/posts" method="POST">
      <textarea name="content" placeholder="What's on your mind ?" class="w-full p-3 rounded bg-gray-800 text-white border border-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-500" rows="3"></textarea>
      <button class="mt-3 bg-blue-500 hover:bg-blue-600 px-4 py-2 rounded text-white">Create New Post</button>
    </form>
  </div>

  
  <div class="w-full max-w-xl">
    <h2 class="text-lg font-semibold mb-4">Your Posts.</h2>

    <% posts.forEach(post => { %>
      <div class="bg-gray-800 p-4 rounded mb-4">
        <p class="text-blue-400 text-sm">@<%= post.username %></p>
        <p class="mt-2 text-gray-300"><%= post.content %></p>
        <div class="mt-2 flex space-x-4 text-sm text-blue-500">
          <form action="/posts/<%= post._id %>/like" method="POST">
            <button type="submit" class="hover:underline">Like</button>
          </form>
          <a href="/posts/<%= post._id %>/edit" class="hover:underline">edit</a>
        </div>
      </div>
    <% }); %>
  </div>
</body>
</html>
